---
import "../index.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content="Nexo Digital | Agencia de Software — Ronald Tellez, Fundador" />
    <meta name="description" content="Nexo Digital es una agencia de desarrollo de software fundada por Ronald Tellez. Desarrollo web, apps Android, soluciones en la nube y automatización de procesos para hacer crecer tu negocio."
    />
    <meta
      name="keywords"
      content="Ronald Tellez, Full Stack Developer, Web Developer, React, TypeScript, Node.js, Portfolio, Nicaragua, Software Engineer"
    />
    <meta name="author" content="Nexo Digital" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://ronaldtellez.dev/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ronaldtellez.dev/" />
    <meta property="og:title" content="Nexo Digital | Agencia de Software" />
    <meta property="og:description" content="Agencia de desarrollo de software fundada por Ronald Tellez. Desarrollo web, apps Android, cloud y automatización para hacer crecer tu negocio."
    />
    <meta property="og:image" content="https://ronaldtellez.dev/og-image.png" />
    <meta property="og:site_name" content="Nexo Digital" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://ronaldtellez.dev/" />
    <meta property="twitter:title" content="Nexo Digital | Agencia de Software" />
    <meta property="twitter:description" content="Agencia de desarrollo de software fundada por Ronald Tellez. Desarrollo web, apps Android, cloud y automatización."
    />
    <meta property="twitter:image" content="https://ronaldtellez.dev/og-image.png" />

    <!-- Resource Hints -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Optimized Font Loading -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;600&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
        rel="stylesheet"
      />
      <link
        href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>

  <body>
    <slot />
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Nexo Digital",
        "description": "Agencia de desarrollo de software: desarrollo web, apps Android, cloud y automatización.",
        "url": "https://ronaldtellez.dev",
        "logo": "https://ronaldtellez.dev/og-image.png",
        "image": "https://ronaldtellez.dev/og-image.png",
        "email": "mailto:micorreo@ronaldtellez.dev",
        "telephone": "+50586053630",
        "foundingDate": "2025",
        "founder": {
          "@type": "Person",
          "name": "Ronald Adan Tellez Ramos",
          "alternateName": "Ronald Tellez",
          "jobTitle": "Fundador de Nexo Digital",
          "url": "https://ronaldtellez.dev",
          "image": "https://avatars.githubusercontent.com/u/80638821?v=4",
          "sameAs": ["https://github.com/zeta-develop"],
          "email": "mailto:micorreo@ronaldtellez.dev",
          "worksFor": {
            "@type": "Organization",
            "name": "Nexo Digital"
          },
          "alumniOf": [
            { "@type": "CollegeOrUniversity", "name": "UNAM - LEÓN" },
            { "@type": "CollegeOrUniversity", "name": "Instituto Politécnico LaSalle" }
          ],
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "León",
            "addressCountry": "Nicaragua"
          }
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "León",
          "addressCountry": "Nicaragua"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "sales",
          "telephone": "+50586053630",
          "email": "mailto:micorreo@ronaldtellez.dev",
          "availableLanguage": "Spanish"
        }
      }
    </script>
    <script src="https://cdn.gpteng.co/gptengineer.js" type="module" is:inline></script>
  </body>
</html>
